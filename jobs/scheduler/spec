---
name: scheduler

templates: 
  bin/ctl.erb: bin/ctl
  env.erb: env

packages:
- scheduler
- scheduler-cf-plugin

properties: 
  scheduler.uaa.client_id:
    description: "Scheduler for OCF UAA Client ID"
  scheduler.uaa.client_secret:
    description: "Scheduler for OCF UAA Client Secret"
  scheduler.uaa.endpoint:
    description: "Scheduler for OCF UAA Endpoint"
  scheduler.cf.api:
    description: "Target CF API Endpoint"
  scheduler.postgres.uri:
    description: "Postgres URI (eg. postgres://user:pass@host:port/db...)"
  scheduler.workers:
    default: 20
    description: "Number of scheduling workers"
  scheduler.log_level:
    description: "Log level trace, debug, info, warn, error, fatal, panic"
    default: "info"
  scheduler.min_interval:
    description: "Shortest allowed gap between a schedule's runs, as a Go duration (eg. 5m); schedules that run more often are rejected. Empty or 0 is off"
    default: ""
  scheduler.broker.enabled:
    description: "Serve the Open Service Broker API under /v2. When true, username, password, and api_url are required"
    default: false
  scheduler.broker.username:
    description: "Basic auth user that Cloud Controller sends to the broker"
    default: scheduler-broker
  scheduler.broker.password:
    description: "Basic auth password that Cloud Controller sends to the broker. Required when the broker is enabled"
  scheduler.broker.api_url:
    description: "Absolute http or https URL of the scheduler API that binding credentials carry. Required when the broker is enabled"
  scheduler.broker.require_binding:
    description: "Refuse job and call creation for apps that are not bound to a scheduler service instance. Requires the broker to be enabled"
    default: false
