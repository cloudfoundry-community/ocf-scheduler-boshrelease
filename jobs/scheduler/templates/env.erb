#!/usr/bin/env bash

export CLIENT_SECRET="<%= p('scheduler.uaa.client_secret') %>"
export CLIENT_ID="<%= p('scheduler.uaa.client_id') %>"
export UAA_ENDPOINT="<%= p('scheduler.uaa.endpoint') %>"
export DATABASE_URL="<%= p('scheduler.postgres.uri') %>"
export CF_ENDPOINT="<%= p('scheduler.cf.api')%>"
export SCHEDULER_WORKERS="<%= p('scheduler.workers')%>"
export LOG_LEVEL="<%= p('scheduler.log_level')%>"
export SCHEDULER_MIN_INTERVAL="<%= p('scheduler.min_interval')%>"

<% if p('scheduler.broker.enabled') -%>
export SCHEDULER_BROKER_ENABLED="true"
export SCHEDULER_BROKER_USERNAME="<%= p('scheduler.broker.username') %>"
export SCHEDULER_BROKER_PASSWORD="<%= p('scheduler.broker.password') %>"
export SCHEDULER_BROKER_API_URL="<%= p('scheduler.broker.api_url') %>"
export SCHEDULER_BROKER_REQUIRE_BINDING="<%= p('scheduler.broker.require_binding') %>"
<% end -%>
